generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url is NOT here in Prisma 7
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  meals        Meal[]
  exercises    Exercise[]
  water        Water[]
  @@map("users")
}

model Meal {
  id          String   @id @default(cuid())
  userId      String
  name        String
  calories    Int
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("meals")
}

model Exercise {
  id          String   @id @default(cuid())
  userId      String
  name        String
  duration    Int
  calories    Int
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("exercises")
}

model Water {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("water_logs")
}